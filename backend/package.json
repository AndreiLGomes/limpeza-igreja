{
  "name": "@limpeza/backend",
  "version": "0.1.0",
  "private": true,
  "description": "Servidor da Escala de Limpeza: Node + Express 5 + PostgreSQL.",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/servidor.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=.env dist/servidor.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "migracao:gerar": "drizzle-kit generate",
    "migrar": "tsx --env-file-if-exists=.env src/banco/migrar.ts",
    "seed": "tsx --env-file-if-exists=.env src/banco/seed.ts"
  },
  "dependencies": {
    "@limpeza/shared": "*",
    "cors": "^2.8.6",
    "drizzle-orm": "^0.45.4",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "pg": "^8.23.1",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "~24.19.2",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "drizzle-kit": "^0.31.11",
    "supertest": "^7.3.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vitest": "^5.0.2"
  }
}
