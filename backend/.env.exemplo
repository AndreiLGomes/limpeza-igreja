# Copie este arquivo para ".env" e ajuste. O ".env" NUNCA vai para o git.

# Porta do servidor.
PORTA=3000

# Banco de desenvolvimento e banco de testes (os dois sobem com "docker compose up -d").
# Usuário e senha "limpeza" valem só para o banco local do docker-compose.yml.
DATABASE_URL=postgres://limpeza:limpeza@localhost:5432/limpeza
DATABASE_URL_TESTE=postgres://limpeza:limpeza@localhost:5432/limpeza_teste

# Hash bcrypt da senha de organizador (nunca a senha pura).
# Gere com "npm run gerar-hash-senha" (comando criado na Etapa 5).
SENHA_ORGANIZADOR_HASH=

# Endereço do front-end que pode chamar a API (CORS).
ORIGEM_FRONTEND=http://localhost:4200
