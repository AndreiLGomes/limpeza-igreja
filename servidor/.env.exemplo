# Copie este arquivo para ".env" e ajuste. O ".env" NUNCA vai para o git.

# Porta do servidor.
PORTA=3000

# Intermediários (proxies) na frente do servidor: 0 no computador, 1 na Render.
PROXIES_CONFIAVEIS=0

# Banco de desenvolvimento e banco de testes (os dois sobem com "docker compose up -d").
# Usuário e senha "limpeza" valem só para o banco local do docker-compose.yml.
URL_DO_BANCO=postgres://limpeza:limpeza@localhost:5432/limpeza
URL_DO_BANCO_TESTE=postgres://limpeza:limpeza@localhost:5432/limpeza_teste

# Hash bcrypt da senha de organizador (nunca a senha pura). Obrigatório.
# Gere com "npm run gerar-hash-senha" e cole aqui a linha que ele mostrar.
SENHA_ORGANIZADOR_HASH=

# Endereço do site que pode chamar a API (CORS).
ORIGEM_DO_SITE=http://localhost:4200
